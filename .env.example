# App configuration
# Frontend Docker Compose uses this internal backend URL. Render must override it
# with the deployed backend service URL, for example https://your-backend.onrender.com.
BACKEND_URL=http://backend:8080
DATABASE_URL=jdbc:postgresql://localhost:5432/shopsense
DATABASE_USERNAME=shopsense
DATABASE_PASSWORD=change-me
DATABASE_DRIVER=org.postgresql.Driver
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=120
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your-gemini-api-key-here
PORT=8080
