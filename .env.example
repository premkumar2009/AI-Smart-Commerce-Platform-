# App configuration
# Vite inlines this at frontend build time. Render should set the deployed backend URL.
VITE_API_BASE_URL=https://shopsense-backend-dcrl.onrender.com
DATABASE_URL=jdbc:postgresql://localhost:5432/shopsense
DATABASE_USERNAME=shopsense
DATABASE_PASSWORD=change-me
DATABASE_DRIVER=org.postgresql.Driver
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=120
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your-gemini-api-key-here
PORT=8080
